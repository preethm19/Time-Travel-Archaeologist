  _actionSets: []
  _definitions:
  - ActionName: Follow The Player
    Description: Start following the player at a comfortable distance, keeping up
      as the player chooses the route, or stop following and stand still.
    Parameters:
    - Name: mode
      Description: Mandatory parameter. You MUST output 'follow' if the player asks
        you to move with them, or 'stop' if the player asks you to halt or wait.
      Type: 5
      Connector: 
      Choices:
      - follow
      - stop
    TargetRequirement: 0
    Executor: {fileID: 766289234}
    ExecutorTypeHint: ConvaiFollowPlayerActionExecutor
    TimeoutSeconds: 0
    FailurePolicyOverride: 0
    AnswerDelivery: 0
    WaitForBotSpeech: 0
    DelayAfterBotSpeechSeconds: 0
    _disabled: 0
    _category: 
  - ActionName: Walk To
    Description: Walk to the named place, object, or person and stop at a natural
      conversational distance. Use this when the character is asked to approach or
      go to a specific target.
